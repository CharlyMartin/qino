{
  "name": "qino-workspace",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "pnpm format:md && pnpm format:code",
    "format:md": "prettier --write \"**/*.md\"",
    "format:code": "biome check --write .",
    "format:check": "prettier --check \"**/*.md\" && biome check .",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=qino && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@changesets/cli": "2.31.0",
    "prettier": "3.8.3",
    "turbo": "2.9.7",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
