{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["CI"]
    },
    "next-js#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!src/content/.qino/**"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "public/llms.txt",
        "public/llms-full.txt",
        "public/index.md",
        "src/content/.qino/**",
        "qino/_generated/**"
      ],
      "env": ["CI"]
    },
    "website#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!content/.qino/**"],
      "outputs": [
        ".output/**",
        ".vercel/output/**",
        "qino/_generated/**",
        "public/llms.txt",
        "public/llms-full.txt",
        "public/index.md"
      ],
      "env": ["NITRO_PRESET", "VERCEL"],
      "passThroughEnv": ["GITHUB_TOKEN"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@qino/tooling#test": {
      "dependsOn": ["^build", "next-js#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/examples/*/qino/_generated/config.json"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {}
  }
}
