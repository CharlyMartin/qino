{
  "name": "@qino/cms",
  "version": "0.1.0",
  "description": "The modern headless Markdown CMS",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    }
  },
  "bin": {
    "qino": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "pnpm build && pnpm check-types && pnpm lint && pnpm test && pnpm check-dist",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "pack": "pnpm build && pnpm pack",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "check-dist": "tsc --project tsconfig.dist.json && node --input-type=module -e \"await import('./dist/index.mjs'); await import('./dist/utils.mjs')\" && publint && pnpm pack --out .check-dist.tgz && attw .check-dist.tgz --profile esm-only; status=$?; node -e \"require('node:fs').rmSync('.check-dist.tgz',{force:true})\"; exit $status"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./utils": {
        "types": "./dist/utils.d.mts",
        "import": "./dist/utils.mjs"
      }
    }
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "consola": "3.4.2",
    "es-toolkit": "1.52.0",
    "fast-glob": "3.3.3",
    "gray-matter": "4.0.3",
    "jiti": "2.7.0",
    "js-yaml": "5.4.2",
    "pluralize": "8.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "type-fest": "5.9.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "22.19.18",
    "@types/pluralize": "0.0.33",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "5.9.2",
    "vitest": "5.0.0",
    "zod": "4.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CharlyMartin/qino.git",
    "directory": "packages/cms"
  },
  "homepage": "https://github.com/CharlyMartin/qino#readme",
  "bugs": {
    "url": "https://github.com/CharlyMartin/qino/issues"
  },
  "keywords": [
    "cms",
    "markdown",
    "headless-cms",
    "flat-file",
    "typescript"
  ],
  "author": "Charly Martin"
}
