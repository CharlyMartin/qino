{
  "name": "qino",
  "version": "0.0.10",
  "description": "The modern headless Markdown CMS",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    }
  },
  "bin": {
    "qino": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepare": "tsdown",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "pack": "pnpm build && pnpm pack",
    "pack:test": "pnpm build && pnpm pack --pack-destination ../../../portfolio/v4",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:dist": "tsc --project tsconfig.dist.json && node --input-type=module -e \"await import('./dist/index.mjs'); await import('./dist/utils.mjs')\"",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./utils": {
        "types": "./dist/utils.d.mts",
        "import": "./dist/utils.mjs"
      }
    },
    "bin": {
      "qino": "./dist/cli.mjs"
    }
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "consola": "3.4.2",
    "es-toolkit": "1.52.0",
    "fast-glob": "3.3.3",
    "gray-matter": "4.0.3",
    "jiti": "2.6.1",
    "js-yaml": "3.14.2",
    "pluralize": "8.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "type-fest": "5.9.0",
    "unified": "11.0.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/js-yaml": "3.12.10",
    "@types/node": ">=22",
    "@types/pluralize": "0.0.33",
    "expect-type": "1.4.0",
    "tsdown": "0.22.14",
    "typescript": "5.9.2",
    "vitest": "4.1.9"
  }
}
