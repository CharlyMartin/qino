{
  "name": "qino",
  "version": "0.0.0",
  "description": "Flat-file Markdown CMS",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "qino": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    },
    "bin": {
      "qino": "./dist/cli.mjs"
    }
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "fast-glob": "3.3.3",
    "gray-matter": "4.0.3",
    "jiti": "2.6.1",
    "type-fest": "5.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "expect-type": "1.3.0",
    "tsdown": "0.21.10",
    "typescript": "5.9.2",
    "vitest": "4.1.5"
  }
}
