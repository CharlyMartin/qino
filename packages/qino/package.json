{
  "name": "qino",
  "version": "0.0.0",
  "description": "Flat-file Markdown CMS",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "qino": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "lint": "echo \"no lint configured yet\""
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    },
    "bin": {
      "qino": "./dist/cli.mjs"
    }
  },
  "dependencies": {
    "jiti": "2.6.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "tsdown": "0.21.10",
    "typescript": "5.9.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "zod": "4.4.3"
  }
}
