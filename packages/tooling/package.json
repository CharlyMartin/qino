{
  "name": "@qino/tooling",
  "version": "0.3.0",
  "description": "Schemas and helpers for tools built on Qino projects",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "pnpm build && pnpm check-types && pnpm lint && pnpm test && pnpm check-dist",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "check-dist": "node --input-type=module -e \"await import('./dist/index.mjs')\" && publint && pnpm pack --out .check-dist.tgz && attw .check-dist.tgz --profile esm-only; status=$?; node -e \"require('node:fs').rmSync('.check-dist.tgz',{force:true})\"; exit $status"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "peerDependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "22.19.18",
    "publint": "0.3.25",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CharlyMartin/qino.git",
    "directory": "packages/tooling"
  },
  "homepage": "https://www.qino.works",
  "bugs": {
    "url": "https://github.com/CharlyMartin/qino/issues"
  },
  "keywords": [
    "cms",
    "qino",
    "zod",
    "schema"
  ],
  "author": "Charly Martin"
}
