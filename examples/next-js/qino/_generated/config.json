{
  "version": 1,
  "config": {
    "contentFolder": "src/content",
    "mediaFolder": "public"
  },
  "collections": {
    "authors": {
      "directory": "authors",
      "extension": ".json",
      "body": null,
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 1
          },
          "lastName": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "company": {
            "type": "string"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "title",
          "company"
        ],
        "additionalProperties": false
      },
      "relations": []
    },
    "categories": {
      "directory": "categories",
      "extension": ".json",
      "body": null,
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "description"
        ],
        "additionalProperties": false
      },
      "relations": []
    },
    "posts": {
      "directory": "posts",
      "extension": ".md",
      "body": {
        "format": "markdown"
      },
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "created-on": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "updated-on": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "categories": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image": {
            "type": "string"
          },
          "author": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "created-on",
          "updated-on",
          "categories",
          "image",
          "author"
        ],
        "additionalProperties": false
      },
      "relations": [
        {
          "path": "author",
          "target": {
            "kind": "collection",
            "id": "authors"
          },
          "cardinality": "one"
        },
        {
          "path": "categories[*]",
          "target": {
            "kind": "collection",
            "id": "categories"
          },
          "cardinality": "many"
        }
      ]
    }
  },
  "items": {
    "pages/home.md": {
      "file": "pages/home.md",
      "extension": ".md",
      "body": {
        "format": "markdown"
      },
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "tagline": {
            "type": "string"
          },
          "featured-posts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "title",
          "tagline",
          "featured-posts"
        ],
        "additionalProperties": false
      },
      "relations": [
        {
          "path": "featured-posts[*]",
          "target": {
            "kind": "collection",
            "id": "posts"
          },
          "cardinality": "many"
        }
      ]
    }
  },
  "trees": {
    "docs/v1": {
      "directory": "docs/v1",
      "extension": ".mdx",
      "titleField": "title",
      "orderFileName": "_order.json",
      "body": {
        "format": "mdx"
      },
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      },
      "relations": []
    },
    "docs/v2": {
      "directory": "docs/v2",
      "extension": ".mdx",
      "titleField": "title",
      "orderFileName": "_order.json",
      "body": {
        "format": "mdx"
      },
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      },
      "relations": []
    }
  }
}
