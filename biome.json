{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": ["**", "!**/routeTree.gen.ts", "!**/qino/_generated"]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noDoubleEquals": "off"
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":BUN:", ":NODE:"],
              ":BLANK_LINE:",
              [":PACKAGE:", "!@myown/**"],
              ":BLANK_LINE:",
              "@myown/**",
              ":BLANK_LINE:",
              [":ALIAS:", ":PATH:"]
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.md", "**/*.mdx"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": [
        ".agents/skills/**",
        "!.agents/skills/changeset/**",
        "!.agents/skills/ship/**"
      ],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    },
    {
      "includes": [
        "packages/cms/src/index.ts",
        "packages/cms/src/utils/index.ts",
        "packages/cms/src/cli/index.ts",
        "packages/tooling/src/index.ts",
        "packages/tooling/src/relations/index.ts",
        "packages/tooling/src/media/index.ts",
        "packages/tooling/src/markdown/index.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off",
            "noReExportAll": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/tooling/src/**",
        "!packages/tooling/src/media/scan-markdown-body.ts",
        "!**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "remark-mdx": "Parse MDX with `scanMarkdownBody`, which reads `{#id}` heading ids: MDX fails on them otherwise.",
                  "micromark-extension-mdxjs": "Parse MDX with `scanMarkdownBody`, which reads `{#id}` heading ids: MDX fails on them otherwise."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/cms/src/**", "!packages/cms/src/index.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/utils", "**/utils/index", "!**/types/utils"],
                    "message": "Import internal helpers from their leaf modules."
                  }
                ],
                "paths": {
                  "remark-mdx": "Parse MDX with `parseMarkdownBody` or `tokenizeMarkdownBody`, which read `{#id}` heading ids: MDX fails on them otherwise.",
                  "micromark-extension-mdxjs": "Parse MDX with `parseMarkdownBody` or `tokenizeMarkdownBody`, which read `{#id}` heading ids: MDX fails on them otherwise."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/cms/src/cli/build/**",
        "!packages/cms/src/cli/build/write-generated-file.ts",
        "!**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["node:fs", "node:fs/*", "fs", "fs/*"],
                    "message": "Write generated files with `writeGeneratedFile`, which skips unchanged ones, and read files through `lib/fs`."
                  },
                  {
                    "group": ["**/utils", "**/utils/index", "!**/types/utils"],
                    "message": "Import internal helpers from their leaf modules."
                  }
                ],
                "paths": {
                  "remark-mdx": "Parse MDX with `parseMarkdownBody` or `tokenizeMarkdownBody`, which read `{#id}` heading ids: MDX fails on them otherwise.",
                  "micromark-extension-mdxjs": "Parse MDX with `parseMarkdownBody` or `tokenizeMarkdownBody`, which read `{#id}` heading ids: MDX fails on them otherwise."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/cms/src/types/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/utils",
                      "**/utils/index",
                      "!**/types/utils",
                      "!./utils"
                    ],
                    "message": "Import internal helpers from their leaf modules."
                  }
                ],
                "paths": {
                  "remark-mdx": "Parse MDX with `parseMarkdownBody` or `tokenizeMarkdownBody`, which read `{#id}` heading ids: MDX fails on them otherwise.",
                  "micromark-extension-mdxjs": "Parse MDX with `parseMarkdownBody` or `tokenizeMarkdownBody`, which read `{#id}` heading ids: MDX fails on them otherwise."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/cms/src/utils/markdown/parse-markdown-body.ts",
        "packages/cms/src/utils/markdown/tokenize-markdown-body.ts",
        "packages/cms/src/**/*.test.ts",
        "!packages/cms/src/types/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/utils", "**/utils/index", "!**/types/utils"],
                    "message": "Import internal helpers from their leaf modules."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
