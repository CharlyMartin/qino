{
  "qinoVersion": "0.0.0",
  "config": {
    "contentFolder": "src/content",
    "mediaFolder": "public"
  },
  "collections": {
    "/authors": {
      "directory": "/authors",
      "extension": ".json",
      "relations": []
    },
    "/categories": {
      "directory": "/categories",
      "extension": ".json",
      "relations": []
    },
    "/posts": {
      "directory": "/posts",
      "extension": ".md",
      "relations": [
        {
          "field": "author",
          "target": "/authors",
          "targetKind": "collection",
          "cardinality": "one"
        },
        {
          "field": "categories[*]",
          "target": "/categories",
          "targetKind": "collection",
          "cardinality": "many"
        }
      ]
    }
  },
  "singletons": {
    "/pages/home.md": {
      "file": "/pages/home.md",
      "extension": ".md",
      "relations": [
        {
          "field": "featured-posts[*]",
          "target": "/posts",
          "targetKind": "collection",
          "cardinality": "many"
        }
      ]
    }
  }
}
